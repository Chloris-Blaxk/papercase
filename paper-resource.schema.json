{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/papercase/paper-resource.schema.json",
  "title": "PaperCase resource",
  "type": "object",
  "required": ["version", "id", "title", "publication", "body"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$" },
    "title": { "type": "string", "minLength": 1 },
    "titleZh": { "type": "string" },
    "authors": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      ]
    },
    "year": { "type": ["integer", "string"] },
    "publication": { "$ref": "#/$defs/publication" },
    "body": { "$ref": "#/$defs/chapters" },
    "appendices": { "$ref": "#/$defs/chapters" }
  },
  "additionalProperties": true,
  "$defs": {
    "publication": {
      "type": "object",
      "required": ["type", "date", "source"],
      "properties": {
        "type": { "enum": ["preprint", "journal", "conference", "workshop", "book-chapter", "thesis", "report", "other"] },
        "date": { "type": "string", "minLength": 4, "description": "Publication or first public release date, preferably YYYY-MM-DD." },
        "source": { "type": "string", "minLength": 1, "description": "Journal, conference, workshop, preprint server, repository, or publisher." },
        "venue": { "type": "string" },
        "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "doi": { "type": "string" },
        "arxivId": { "type": "string" },
        "volume": { "type": ["string", "integer"] },
        "issue": { "type": ["string", "integer"] },
        "pages": { "type": "string" }
      },
      "additionalProperties": true
    },
    "chapters": {
      "type": "array",
      "items": { "$ref": "#/$defs/chapter" }
    },
    "chapter": {
      "type": "object",
      "required": ["id", "titleEn", "items"],
      "properties": {
        "id": { "type": "string" },
        "sectionNumber": { "type": ["string", "null"] },
        "titleEn": { "type": "string" },
        "titleZh": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/item" }
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["pair", "equation", "asset"] },
        "id": { "type": "string" },
        "en": { "type": "string" },
        "zh": { "type": "string" },
        "tex": { "type": "string" },
        "kind": { "type": "string" },
        "number": { "type": ["string", "integer"] },
        "src": { "type": "string" },
        "captionEn": { "type": "string" },
        "captionZh": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "pair" } } }, "then": { "required": ["en", "zh"] } },
        { "if": { "properties": { "type": { "const": "equation" } } }, "then": { "required": ["tex"] } },
        { "if": { "properties": { "type": { "const": "asset" } } }, "then": { "required": ["src"] } }
      ],
      "additionalProperties": true
    }
  }
}
